[Desktop Entry]
Type=Application
Name=OmniHub
GenericName=AI Gateway & System Hub
Comment=SojibLabs OmniRoute & System Control Center
Exec=/home/sojiblabs/.local/bin/omnihub %U
Icon=omnihub
Terminal=false
Categories=Development;Utility;System;Network;
Keywords=ai;gateway;omniroute;system;monitor;chat;llm;
StartupWMClass=omnihub
StartupNotify=true
SingleMainWindow=true
X-Deepin-Vendor=user
Actions=dashboard;restart_service;ai_studio;settings;

[Desktop Action dashboard]
Name=Open OmniRoute Dashboard
Exec=xdg-open http://localhost:20128/dashboard

[Desktop Action restart_service]
Name=Restart OmniRoute Service
Exec=/home/sojiblabs/.local/bin/omnihub --restart

[Desktop Action ai_studio]
Name=Open AI Studio
Exec=/home/sojiblabs/.local/bin/omnihub --page ai

[Desktop Action settings]
Name=Open OmniHub Settings
Exec=/home/sojiblabs/.local/bin/omnihub --page settings
